public static void updateStudent(String name,int age) {
		Connection con= null;
		try{con = DbConnection.getConnection();
		con.setAutoCommit(false);
				
			String sql2="update student set agee=? where name =?";
			PreparedStatement stmt2 = con.prepareStatement(sql2);
			stmt2.setInt(1,age);
			stmt2.setString(2,name);
			stmt2.executeUpdate();
			con.commit();
			System.out.println("commited succesfully");
			
		}catch (SQLIntegrityConstraintViolationException e) {
		    System.out.println("Constraint Violation: Student '" + name + "' already exists!");
		    try {if(con !=null) {
		    	con.rollback();
		    	System.out.println("update rolled back");
		    }
		    }catch(Exception ex) {
		    	ex.printStackTrace();
		    }
		}catch(Exception e) {
			try {
				if(con !=null) {
			    	con.rollback();
			    	System.out.println("update rolled back");
			    }
			}catch(Exception ex) {
				ex.printStackTrace();
			}
			
			e.printStackTrace();
		}
	}
